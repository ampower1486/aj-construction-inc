# Copy this file to `.env` and fill in the value below.
#
# Where estimate requests and assistant conversations are delivered.
#
# Set up:
#   1. Create a free form at https://formspree.io  (or Basin, Web3Forms, etc.)
#   2. Point it at  aj.construction.inc2@gmail.com
#   3. Paste the endpoint URL here
#
# Until this is set, the site still works — the form and the assistant fall back
# to opening the visitor's email client with everything pre-filled, so a lead is
# never lost. But it is a worse experience, so set it before launch.
VITE_FORM_ENDPOINT=

# Reserved for the AI upgrade. Leave unset to run the scripted assistant.
# See README.md → "Upgrading the assistant to Claude".
# VITE_CHAT_ENGINE=claude

# --------------------------------------------------------------------------
# Staff portal (/admin) — accounts, roles, invites.
# See supabase/schema.sql and supabase/README.md for full setup.
# --------------------------------------------------------------------------

# Project Settings -> API in the Supabase dashboard. Both values below are
# safe to expose to the browser by design (Row Level Security is the real
# security boundary, not hiding these).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Same page, "service_role" key. This one is a SECRET — it bypasses Row
# Level Security entirely. Never prefix it with VITE_ (that prefix tells
# Vite to inline a value into the browser bundle) and never commit it.
# Used only by api/invite-user.js.
SUPABASE_SERVICE_ROLE_KEY=
